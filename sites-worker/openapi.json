    "/genepedia/pull-requests/review": {
      "post": {
        "tags": [
          "Review"
        ],
        "summary": "Merge or decline an edit request",
        "security": [
          {
            "bearerToken": []
          },
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/JsonObject"
        },
        "responses": {
          "200": {
            "description": "Review action completed"
          },
          "401": {
            "description": "GitHub-authenticated reviewer required"
          },
          "403": {
            "description": "Caller is not the configured reviewer"
