{
  "openapi": "3.1.0",
  "info": {
    "title": "Genepedia API",
    "version": "1.0.0",
    "description": "Versioned JSON API for Genepedia and Gravepedia. Published content is stored in fixed GitHub repositories; D1 stores short-lived authentication state and queued statistics."
  },
  "servers": [
    {
      "url": "https://api.genepedia.org/v1",
      "description": "Production API"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Content"
    },
    {
      "name": "Profiles"
    },
    {
      "name": "Review"
    },
    {
      "name": "Statistics"
    },
    {
      "name": "Gravepedia"
    }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "summary": "Download this OpenAPI contract",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 contract as JSON"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Discover API version and site bases",
        "responses": {
          "200": {
            "description": "API discovery document"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Complete shared GitHub OAuth flow",
        "description": "OAuth state identifies which site started sign-in; browsers should reach this route through GitHub.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the initiating site"
          },
          "400": {
            "description": "Invalid or expired OAuth state"
          }
        }
      }
    },
    "/genepedia/auth/github/config": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Read public authentication configuration",
        "responses": {
          "200": {
            "description": "Public GitHub and login configuration"
          }
        }
      }
    },
    "/genepedia/auth/github/login": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Start GitHub sign-in",
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to GitHub authorization"
          },
          "503": {
            "description": "OAuth is not configured"
          }
        }
      }
    },
    "/genepedia/auth/local/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with the optional local account",
        "requestBody": {
          "$ref": "#/components/requestBodies/JsonObject"
        },
        "responses": {
          "200": {
            "description": "One-time handoff for the new session"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/genepedia/auth/session": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Read the current session",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authentication state and public user details"
          }
        }
      }
    },
    "/genepedia/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "End the current session",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session ended"
          }
        }
      }
    },
    "/genepedia/auth/handoff": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Redeem a single-use login handoff",
        "requestBody": {
          "$ref": "#/components/requestBodies/JsonObject"
        },
        "responses": {
          "200": {
            "description": "Session details and cookie"
          },
          "401": {
            "description": "Invalid, expired, or already-used handoff"
          }
        }
      }
    },
    "/genepedia/data": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Read an allowed public GitHub data file",
        "parameters": [
          {
            "$ref": "#/components/parameters/Path"
          }
        ],
        "responses": {
          "200": {
            "description": "File contents or JSON data"
          },
          "400": {
            "description": "Path is outside the fixed repositories"
          }
        }
      }
    },
    "/genepedia/media": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Read an allowed public media file",
        "parameters": [
          {
            "$ref": "#/components/parameters/Path"
          }
        ],
        "responses": {
          "200": {
            "description": "Media file"
          },
          "404": {
            "description": "Media file not found"
          }
        }
      }
    },
    "/genepedia/files/commits": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Read file history",
        "parameters": [
          {
            "$ref": "#/components/parameters/Path"
          },
          {
            "name": "paths",
            "in": "query",
            "description": "Optional comma-separated list of up to 12 paths in one fixed repository",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Normalized commit list"
          },
          "400": {
            "description": "Invalid or unsupported file path"
          }
        }
      }
    },
    "/genepedia/files/commit-diff": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Read the diff for an allowed file and commit",
        "parameters": [
          {
            "$ref": "#/components/parameters/Path"
          },
          {
            "name": "hash",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commit diff"
          },
          "400": {
            "description": "Invalid path or commit hash"
          }
        }
      }
    },
    "/genepedia/pull-requests": {
