# Example environment variables for the API (do not commit secrets)
# Copy this to your server environment or a secure location and populate

GITHUB_CLIENT_ID=Ov23liPGTumhPzPYFhnh
GITHUB_CLIENT_SECRET=your_github_app_secret_here

# Required for commit history / file diffs (5,000 GitHub API requests/hour).
# Classic PAT: public_repo scope. Fine-grained: Contents (Read) + Metadata (Read).
GITHUB_API_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=Genepedia/Genepedia

# Optional GitHub App auth instead of a PAT:
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/secure/path/github-app.pem
GITHUB_ALLOWED_RETURN_ORIGINS=https://genepedia.org,https://www.genepedia.org,https://api.shaunroselt.com
GITHUB_ALLOWED_CORS_ORIGINS=https://genepedia.org,https://www.genepedia.org
GITHUB_DEFAULT_RETURN_TO=https://www.genepedia.org/
GITHUB_SESSION_SAMESITE=None
